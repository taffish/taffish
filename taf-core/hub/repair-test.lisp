;;;; Synthetic files only. No install, clone, project build, or script execution.

(defun %repair-test-fixture (root &key (scope :user) home bin (version "1.0.0"))
  (let* ((home (or home (taf.core::%hub-installed-path-key
                        (han.path:join-path root "home/") t)))
         (bin (or bin (han.path:join-path home "bin/")))
         (id (format nil "~A-r1" version))
         (name "repair-demo") (command "taf-repair-demo")
         (artifact (format nil "~A-v~A" command id))
         (repository "https://github.com/taffish/repair-demo")
         (commit (make-string 40 :initial-element #\a))
         (record (han.json:json-object
                  (cons "name" name) (cons "kind" "tool")
                  (cons "version" version) (cons "release" 1) (cons "version_id" id)
                  (cons "repository_url" repository)
                  (cons "command" (han.json:json-object (cons "name" command)))
                  (cons "source" (han.json:json-object (cons "clone_url" repository)
                                                       (cons "commit" commit)))))
         (paths (taf.core::%hub-install-paths home name id artifact :bin-dir bin :command-name command))
         (wrapper (han.path:->namestring (han.path:join-path (getf paths :source-dir) "target/" artifact)))
         (snapshot (han.path:join-path (getf paths :source-dir) "target/" (format nil ".~A/" artifact)))
         (result (append (list :home home :scope scope :package-name name :version-id id
                               :artifact-name artifact :command-name command :command-file wrapper
                               :source-url repository :source-commit commit :origin-kind :hub-index :origin name)
                         paths)))
    (%taf-hub-write-string wrapper (format nil "#!/bin/sh~%exit 99~%"))
    (%taf-hub-write-string (han.path:join-path snapshot "taffish.toml")
                          (format nil "[package]~%name = ~S~%version = ~S~%release = 1~%main = ~S~%[command]~%name = ~S~%"
                                  name version "src/main.taf" command))
    (%taf-hub-write-string (han.path:join-path snapshot "src/main.taf") "fixture")
    (%taf-hub-write-string (han.path:join-path snapshot "docs/help.md") "fixture")
    (taf.core::%build-write-manifest snapshot artifact
                                    (taf.core::%build-snapshot-digest snapshot)
                                    (taf.core::%project-sha256-file wrapper))
    (dolist (pair (list (list (getf paths :launcher-file) artifact)
                        (list (getf paths :command-launcher-file) command)))
      (%taf-hub-write-string (first pair)
                            (taf.core::%hub-install-launcher-string wrapper
                             :launcher-name (second pair) :artifact-name artifact)))
    (dolist (file (list wrapper (getf paths :launcher-file) (getf paths :command-launcher-file)))
      (taf.core::%chmod-executable file))
    (han.json:write-json-file (getf paths :metadata-file)
                             (taf.core::%hub-install-metadata-json result record))
    (append (list :record record :snapshot snapshot
                  :manifest (taf.core::%build-manifest-file snapshot)) result)))

(defun %repair-test-plan (fixture &rest overrides)
  (apply #'taf.core::%hub-repair-plan-one
         (append overrides
                 (list :query "repair-demo" :version-id (getf fixture :version-id)
                       :scope (getf fixture :scope) :user-home (getf fixture :home)
                       :system-home (getf fixture :home) :system-bin-dir (getf fixture :bin-dir)
                       :index-record (getf fixture :record)))))

(defun %repair-test-expect (fixture action reason &rest overrides)
  (let ((plan (apply #'%repair-test-plan fixture overrides)))
    (unless (and (eq action (getf plan :action)) (equal reason (getf plan :reason))
                 (eq (eq action :blocked) (getf plan :blocked-p)))
      (error "Expected ~S/~A; got ~S/~A (~A), validations ~S"
             action reason (getf plan :action) (getf plan :reason)
             (getf plan :detail) (getf plan :validations)))
    plan))

(defun %repair-test-metadata (fixture key value &optional remove-p)
  (let* ((file (getf fixture :metadata-file)) (object (han.json:read-json-file file)))
    (if remove-p (remhash key object) (setf (gethash key object) value))
    (han.json:write-json-file file object)))

(defun %repair-test-link (target link)
  (multiple-value-bind (out err code)
      (han.os:run-program (list (han.os:find-executable "ln") "-s"
                               (han.path:->namestring target)
                               (string-right-trim "/" (han.path:->namestring link))))
    (declare (ignore out err))
    (check-equal 0 code)))

