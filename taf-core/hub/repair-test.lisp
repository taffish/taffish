(deftest test-taf-hub-repair-transaction-fixed-commit-rewrite-and-unchanged-alias ()
  (%with-repair-transaction-directory (root)
    (let* ((fixture (%repair-test-transaction-fixture root)) (repository (getf fixture :repository))
           (help (han.path:join-path repository "docs/help.md"))
           (committed-help (taf.core::%project-sha256-file help))
           (new (%repair-test-fixture root :home (getf fixture :home) :version "2.0.0"))
           (alias (getf fixture :command-launcher-file)) (launcher (getf fixture :launcher-file))
           (alias-inode (%repair-test-inode alias)) (launcher-inode (%repair-test-inode launcher))
           (new-digest (taf.core::%build-snapshot-digest (getf new :install-root)))
           (before (taf.core::%build-snapshot-digest (getf fixture :install-root))))
      (%repair-test-git repository "tag" "v1.0.0-r1")
      (%taf-hub-write-string help "moved tag content")
      (%repair-test-git repository "add" "--all")
      (%repair-test-git repository "commit" "--quiet" "-m" "mutable tag moved")
      (%repair-test-git repository "tag" "-f" "v1.0.0-r1")
      (%taf-hub-write-string help "uncommitted source edit")
      (let* ((result (%repair-test-apply fixture))
             (journal (han.json:read-json-file (getf result :journal)))
             (metadata (han.json:read-json-file (getf fixture :metadata-file))))
        (check-equal :repaired (getf result :action))
        (check-equal "committed" (han.json:get-json journal "status"))
        (check-equal before (taf.core::%build-snapshot-digest (getf result :backup-root)))
        (check-equal committed-help (taf.core::%project-sha256-file
                                     (han.path:join-path (getf fixture :source-dir) "docs/help.md")))
        (check-equal "uncommitted source edit" (han.os:load-string help))
        (check-equal "https://github.com/taffish/repair-demo" (han.json:get-json metadata "source_url"))
        (check-equal (namestring repository) (han.json:get-json metadata "resolved_source_url"))
        (check-equal (getf result :source-commit) (han.json:get-json metadata "source_commit_actual"))
        (check-equal alias-inode (%repair-test-inode alias))
        (check-equal launcher-inode (%repair-test-inode launcher))
        (check-equal new-digest (taf.core::%build-snapshot-digest (getf new :install-root)))
        (check-false (search "/stage-root/" (han.json:encode-json metadata)))
        (check-false (search "/stage-root/" (han.os:load-string (getf fixture :command-file))))
        (check-false (getf result :record))
        (check-equal :skip (getf (%repair-test-apply fixture) :action))))))

(deftest test-taf-hub-repair-transaction-switch-failures-restore-and-keep-backups ()
  (dolist (phase '("source-verified" "stage-built" "backup-root-intent" "root-backed-up"
                    "root-switched" "launcher-switched" "alias-switched" "final-verified"))
    (%with-repair-transaction-directory (root)
      (let* ((fixture (%repair-test-transaction-fixture root))
             (before (taf.core::%build-snapshot-digest (getf fixture :install-root)))
             (fired nil))
        (dolist (key '(:launcher-file :command-launcher-file))
          (taf.core::%hub-repair-run "chmod" (list "644" (getf fixture key))))
        (let* ((taf.core::*hub-repair-transaction-test-hook*
                 (lambda (current transaction) (declare (ignore transaction))
                   (when (and (equal current phase) (not fired))
                     (setf fired t) (error "Injected failure: ~A" phase))))
               (condition (%repair-test-condition (lambda () (%repair-test-apply fixture))))
               (journal-file (taf.core::%hub-repair-error-journal condition))
               (journal (han.json:read-json-file journal-file)))
          (check-true fired)
          (check-equal "repair-failed" (taf.core::%hub-repair-error-reason condition))
          (check-equal before (taf.core::%build-snapshot-digest (getf fixture :install-root)))
          (check-true (member (han.json:get-json journal "status") '("rolled-back" "failed-before-switch") :test #'equal))
          (when (han.json:get-json journal "old_root_moved")
            (check-equal before (taf.core::%build-snapshot-digest (han.json:get-json journal "backup-root"))))
          (dolist (key '(:launcher-file :command-launcher-file))
            (check-false (taf.core::%with-hub-repair-fresh-probes (taf.core::%hub-diagnostic-test "-x" (getf fixture key)))))
          (check-false (probe-file (han.path:join-path (getf fixture :home) ".taffish-write.lock/"))))))))

(deftest test-taf-hub-repair-transaction-rollback-failure-blocks-all-writers ()
  (%with-repair-transaction-directory (root)
    (let* ((fixture (%repair-test-transaction-fixture root))
           (taf.core::*hub-repair-transaction-test-hook*
             (lambda (phase transaction) (declare (ignore transaction))
               (when (member phase '("root-switched" "rollback-intent") :test #'equal) (error "Injected rollback failure"))))
           (condition (%repair-test-condition (lambda () (%repair-test-apply fixture))))
           (journal (han.json:read-json-file (taf.core::%hub-repair-error-journal condition)))
           (writes 0))
      (check-equal "recovery-required" (taf.core::%hub-repair-error-reason condition))
      (check-equal "recovery-required" (han.json:get-json journal "status"))
      (check-true (probe-file (han.json:get-json journal "backup-root")))
      (%repair-test-expect fixture :blocked "recovery-required")
      (let ((taf.core::*hub-repair-transaction-test-hook* nil))
        (check-equal "recovery-required"
                     (taf.core::%hub-repair-error-reason
                      (%repair-test-condition (lambda ()
                        (taf.core::%hub-call-with-write-locks (getf fixture :home) (getf fixture :bin-dir)
                         (lambda () (incf writes))))))))
      (check-equal 0 writes))))

