(deftest test-taf-hub-repair-transaction-flow-does-not-install-dependencies ()
  (%with-repair-transaction-directory (root)
    (let* ((fixture (%repair-test-transaction-fixture root :scope :system :flow-p t))
           (original (symbol-function 'taf.core::%hub-install-dependency)) (calls 0))
      (taf.core::%hub-repair-run "chmod" (list "750" (getf fixture :install-root)))
      (unwind-protect
           (progn
             (setf (symbol-function 'taf.core::%hub-install-dependency)
                   (lambda (&rest args) (declare (ignore args)) (incf calls) (error "No dependency installs")))
             (let ((result (%repair-test-apply fixture)))
               (check-equal :repaired (getf result :action))
               (check-equal "0750" (taf.core::%hub-repair-mode-string (getf fixture :install-root)))
               (check-equal "0700" (taf.core::%hub-repair-mode-string (getf result :backup-directory)))
               (check-equal "0700" (taf.core::%hub-repair-mode-string (getf result :entry-backup-dir))))
             (check-equal 0 calls))
        (setf (symbol-function 'taf.core::%hub-install-dependency) original)))))

(deftest test-taf-hub-repair-transaction-fetch-commit-build-failures ()
  (dolist (failure '(:fetch :commit :build))
    (%with-repair-transaction-directory (root)
      (let* ((fixture (%repair-test-transaction-fixture root))
             (original (symbol-function 'taf.core:project-build)))
        (case failure
          (:fetch
           (let ((empty (han.path:join-path root "not-a-repository/")))
             (ensure-directories-exist empty)
             (%taf-hub-write-string
              (taf.core::%taffish-config-file (getf fixture :home))
              (format nil "schema_version = ~S~%[[source.rewrite]]~%from = ~S~%to = ~S~%enabled = true~%"
                      "taffish.config/v1" "https://github.com/taffish/repair-demo" (namestring empty)))))
          (:commit
           (let ((commit (make-string 40 :initial-element #\c)))
             (setf (gethash "commit" (han.json:get-json (getf fixture :record) "source")) commit)
             (%repair-test-metadata fixture "source_commit" commit)
             (%repair-test-write-index fixture))))
        (let ((before (taf.core::%build-snapshot-digest (getf fixture :install-root))))
          (unwind-protect
               (progn
                 (when (eq failure :build)
                   (setf (symbol-function 'taf.core:project-build)
                         (lambda (&rest args) (declare (ignore args)) (error "Injected build failure"))))
                 (let* ((condition (%repair-test-condition (lambda () (%repair-test-apply fixture))))
                        (journal (han.json:read-json-file (taf.core::%hub-repair-error-journal condition))))
                   (check-equal "repair-failed" (taf.core::%hub-repair-error-reason condition))
                   (check-equal "failed-before-switch" (han.json:get-json journal "status"))
                   (check-false (han.json:get-json journal "old_root_moved"))
                   (check-equal before (taf.core::%build-snapshot-digest (getf fixture :install-root)))))
            (setf (symbol-function 'taf.core:project-build) original)))))))

