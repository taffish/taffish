           (result (getf plan :resolved-result)))
      (dolist (key '(:package-name :version-id :artifact-name :command-name :scope :home
                    :bin-dir :source-dir :install-root :metadata-file :command-file
                    :launcher-file :command-launcher-file :record :source-commit))
        (check-true (getf result key)))
      (check-equal (getf plan :home) (taf.core::%hub-installed-path-key (getf fixture :home) t))
      (check-equal (getf plan :bin-dir) (taf.core::%hub-installed-path-key (getf fixture :bin-dir) t))
      (check-equal :verified (getf (getf plan :validation) :state))
      (check-true (getf (getf plan :preconditions) :metadata-sha256))
      (check-true (getf (getf plan :preconditions) :record-sha256)))))

