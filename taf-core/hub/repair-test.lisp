(deftest test-taf-hub-repair-plan-batch-reuses-records-and-no-writers ()
  (with-taf-hub-temp-dir (root)
    (let* ((fixture (%repair-test-fixture root))
           (entries (taf.core::%hub-uninstall-installed-entries (getf fixture :home)))
           (entry-before (copy-tree (first entries)))
           (before (taf.core::%build-snapshot-digest root))
           (calls nil)
           (symbols '(taf.core::%hub-load-index taf.core::%hub-uninstall-installed-entries
                      taf.core:hub-install taf.core:project-build
                      taf.core::%hub-install-copy-or-clone-source
                      taf.core::%hub-install-write-launcher taf.core::%hub-install-refresh-command-alias))
           (originals (mapcar (lambda (s) (cons s (symbol-function s))) symbols)))
      (unwind-protect
           (progn
             (dolist (symbol symbols)
               (let ((name symbol))
                 (setf (symbol-function name)
                       (lambda (&rest args) (declare (ignore args))
                         (push name calls) (error "Forbidden plan call: ~A" name)))))
             (taf.core::%hub-call-with-diagnostic-batch
              entries (lambda ()
                        (dotimes (i 3)
                          (%repair-test-expect fixture :skip "already-verified" :installed-entries entries))))
             ;; Supplied NIL is still supplied, not a request to enumerate everything.
             (%repair-test-expect fixture :skip "already-verified" :installed-entries nil)
             (check-equal nil calls)
             (check-equal entry-before (first entries))
             (check-equal before (taf.core::%build-snapshot-digest root)))
        (dolist (pair originals) (setf (symbol-function (car pair)) (cdr pair)))))))

