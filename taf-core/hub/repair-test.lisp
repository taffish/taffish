(deftest test-taf-hub-repair-plan-reason-translations ()
  (dolist (reason '("already-verified" "rebuild-required" "not-installed" "invalid-target"
                    "index-target-invalid" "identity-mismatch" "metadata-invalid" "unknown-schema"
                    "scope-mismatch" "unsafe-path" "read-error" "unsafe-or-unreadable"
                    "private-or-unknown-source" "source-conflict" "invalid-source-commit"
                    "source-commit-conflict" "missing-fixed-commit" "command-conflict"
                    "launcher-unrecognized" "alias-unrecognized" "inspection-failed"))
    (let* ((suffix (concatenate 'string "repair.reason." reason))
           (english (taffish.i18n:with-language ("en") (taf.core::%hub-message suffix)))
           (chinese (taffish.i18n:with-language ("zh") (taf.core::%hub-message suffix))))
      (check-false (equal english chinese))
      (check-false (search "hub.repair.reason." english))
      (check-false (search "hub.repair.reason." chinese)))))

