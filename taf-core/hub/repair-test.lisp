;;;; Transaction fixtures remain entirely under a unique temporary directory.

(defmacro %with-repair-transaction-directory ((root) &body body)
  `(let ((,root (han.path:join-path (han.host:temporary-directory)
                                   (format nil "taf-repair-test-~A/" (taf.core::%hub-repair-token)))))
     (ensure-directories-exist ,root)
     (unwind-protect (progn ,@body)
       (han.host:delete-directory-tree ,root :validate t :if-does-not-exist :ignore))))

(defun %repair-test-git (source &rest arguments)
  (taf.core::%hub-repair-run "git"
   (append (list "-C" (han.path:->namestring source)
                 "-c" "user.name=Repair Fixture" "-c" "user.email=repair@example.invalid"
                 "-c" "commit.gpgsign=false" "-c" "core.hooksPath=/dev/null") arguments)))

(defun %repair-test-write-index (fixture)
  (let* ((record (getf fixture :record))
         (package (han.json:json-object
                    (cons "name" "repair-demo") (cons "latest" (getf fixture :version-id))
                    (cons "repository_url" (han.json:get-json record "repository_url"))
                    (cons "command" (han.json:get-json record "command"))
                    (cons "versions" (han.json:json-object (cons (getf fixture :version-id) record)))))
         (index (han.json:json-object
                  (cons "schema_version" "taffish.index/v1")
                  (cons "packages" (han.json:json-object (cons "repair-demo" package)))
                  (cons "commands" (han.json:json-object
                                     (cons "taf-repair-demo" (han.json:json-object
                                       (cons "package" "repair-demo")
                                       (cons "version" (getf fixture :version-id)))))))))
    (%taf-hub-write-current-index (getf fixture :home) (han.json:encode-json index))))

(defun %repair-test-transaction-fixture (root &key (scope :user) flow-p)
  (let* ((fixture (%repair-test-fixture root :scope scope))
         (parent (han.path:join-path root "repository/"))
         (repository (han.path:join-path parent "repair-demo/")))
    (ensure-directories-exist parent)
    (uiop:with-current-directory (parent)
      (let ((*standard-output* (make-string-output-stream)))
        (taf.core:project-new "repair-demo" (list (if flow-p "--flow" "--tool") "--version" "1.0.0"))))
    (%repair-test-git repository "init" "--quiet")
    (%repair-test-git repository "add" "--all")
    (%repair-test-git repository "commit" "--quiet" "-m" "fixed fixture")
    (let ((commit (string-trim '(#\Space #\Newline #\Return) (%repair-test-git repository "rev-parse" "HEAD"))))
      (setf (gethash "commit" (han.json:get-json (getf fixture :record) "source")) commit)
      (%repair-test-metadata fixture "source_commit" commit))
    (when flow-p
      (setf (gethash "kind" (getf fixture :record)) "flow")
      (%repair-test-metadata fixture "kind" "flow"))
    (%taf-hub-write-string
     (taf.core::%taffish-config-file (getf fixture :home))
     (format nil "schema_version = ~S~%[[source.rewrite]]~%from = ~S~%to = ~S~%enabled = true~%"
             "taffish.config/v1" "https://github.com/taffish/repair-demo" (namestring repository)))
    (%repair-test-write-index fixture)
    (delete-file (getf fixture :manifest))
    (append (list :repository repository) fixture)))

(defun %repair-test-apply (fixture &optional plan)
  (let ((plan (or plan (%repair-test-plan fixture))))
    (taf.core::%hub-call-with-write-locks (getf fixture :home) (getf fixture :bin-dir)
     (lambda () (taf.core::%hub-repair-apply-one plan)))))

(defun %repair-test-condition (thunk)
  (handler-case (progn (funcall thunk) nil) (error (condition) condition)))

(defun %repair-test-inode (path)
  (parse-integer (taf.core::%hub-repair-run "ls" (list "-di" (han.path:->namestring path))) :junk-allowed t))

(deftest test-taf-hub-repair-transaction-lock-subsets-and-contention ()
  (%with-repair-transaction-directory (root)
    (let ((home (han.path:join-path root "home/"))
          (a (han.path:join-path root "bin-a/")) (b (han.path:join-path root "bin-b/"))
          (other (han.path:join-path root "other/")))
      (taf.core::%hub-call-with-write-locks
       home (list b a)
       (lambda ()
         (check-equal '(1 2) (multiple-value-list
                              (taf.core::%hub-call-with-write-locks home a (lambda () (values 1 2)))))
         (check-equal "write-lock-upgrade"
                      (taf.core::%hub-repair-error-reason
                       (%repair-test-condition (lambda ()
                         (taf.core::%hub-call-with-write-locks home other (lambda () (error "must not run")))))))
         (check-false (probe-file other))
         (let ((taf.core::*hub-write-lock-token* nil))
           (check-equal "write-lock-busy"
                        (taf.core::%hub-repair-error-reason
                         (%repair-test-condition (lambda ()
                           (taf.core::%hub-call-with-write-locks home b (lambda () (error "must not run"))))))))))
      (dolist (resource (list home a b))
        (check-false (probe-file (han.path:join-path resource ".taffish-write.lock/")))))))

