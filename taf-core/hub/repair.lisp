(in-package :taf.core)

;;;; Read-only planning and explicit, locked repair transactions.

(defun %register-hub-repair-i18n-messages ()
  (dolist (entry
           '(("already-verified" "Installation and command entries passed the local checks; no rebuild is needed." "安装及命令入口已通过本地检查，无需重建。")
             ("rebuild-required" "This installed identity can be rebuilt from its fixed source commit; backups must be retained." "可从固定源码 commit 重建此已安装身份；必须保留备份。")
             ("not-installed" "This target is not installed; repair does not install new apps or dependencies." "此目标尚未安装；修复不会新增应用或依赖。")
             ("invalid-target" "The target contains an invalid or unsafe path component." "目标含有无效或不安全的路径部分。")
             ("index-target-invalid" "The local index cannot resolve this target safely." "本地索引无法安全解析此目标。")
             ("identity-mismatch" "The requested identity, index, or installed metadata does not agree." "请求身份、索引或安装记录不一致。")
             ("metadata-invalid" "The installation directory exists but its metadata is missing or malformed." "安装目录存在，但安装记录缺失或损坏。")
             ("unknown-schema" "An unsupported metadata format must not be overwritten." "不得覆盖当前不支持的元数据格式。")
             ("scope-mismatch" "Installed metadata does not match the requested installation scope." "安装记录与请求的安装作用域不一致。")
             ("unsafe-path" "A path escapes the managed layout, is a link, or has an unexpected file type." "路径超出受管理位置、属于链接或文件类型不符。")
             ("read-error" "A required path is not readable or searchable; inspect access without blindly changing permissions." "必要路径不可读取或遍历；请检查访问权限，不要盲目修改权限。")
             ("unsafe-or-unreadable" "The available path or metadata evidence cannot establish a safe repair." "现有路径或元数据证据不足以确认修复安全。")
             ("private-or-unknown-source" "Only known Hub-index installations may be repaired from the index." "仅来源明确的 Hub 索引安装可从索引修复。")
             ("source-conflict" "Installed and indexed source identities disagree or are incomplete." "安装记录与索引的来源身份冲突或不完整。")
             ("invalid-source-commit" "The indexed commit is not a full hexadecimal Git object identifier." "索引 commit 不是完整的十六进制 Git 对象标识。")
             ("source-commit-conflict" "The fixed index commit disagrees with the installed source record." "索引固定 commit 与安装源码记录不一致。")
             ("missing-fixed-commit" "Rebuilding requires a fixed source commit, which this index record does not provide." "重建必须有固定源码 commit，而此索引记录未提供。")
             ("command-conflict" "Another installed package claims the same command entry." "另一个已安装应用声明了相同的命令入口。")
             ("launcher-unrecognized" "The versioned entry is not an exactly recognized managed template; preserve possible user edits." "带版本入口不是精确识别的受管理模板；保留可能的用户修改。")
             ("alias-unrecognized" "The command shortcut is not an exactly recognized managed template; preserve possible user edits." "命令快捷入口不是精确识别的受管理模板；保留可能的用户修改。")
             ("inspection-failed" "Read-only inspection failed; no repair is authorized." "只读检查失败；未授权执行修复。")))
    (destructuring-bind (reason english chinese) entry
      (taffish.i18n:register-message (concatenate 'string "taf.hub.repair.reason." reason)
                                     english chinese))))

(%register-hub-repair-i18n-messages)

(defun %hub-repair-string (object key)
  (let ((value (and (han.json:json-object-p object)
                    (han.json:get-json object key))))
    (and (stringp value) (%hub-non-empty-string-p value) value)))

(defun %hub-repair-optional-string-p (object key)
  (let ((value (han.json:get-json object key :missing)))
    (or (member value '(:missing :null nil)) (stringp value))))

(defun %hub-repair-path-part-p (value)
  (and (%hub-non-empty-string-p value)
       (not (member value '("." "..") :test #'equal))
       (not (find-if (lambda (c) (or (find c "/\\")
                                     (< (char-code c) 32) (= (char-code c) 127)))
                     value))
       (not (wild-pathname-p (han.path:->pathname value)))))

(defun %hub-repair-commit-p (value)
  (and (stringp value) (member (length value) '(40 64))
       (every (lambda (c) (find c "0123456789abcdefABCDEF")) value)))

(defun %hub-repair-launcher-owned-p (path launcher-name entries)
  ;; Exact templates only: never infer ownership from shell text or a filename.
  (or (not (%hub-diagnostic-test "-e" path))
      (let ((digest (%project-sha256-file path)))
        (some (lambda (entry)
                (and (null (%hub-installed-path-problem entry))
                     (string= digest
                              (%project-sha256-string
                               (%hub-install-launcher-string
                                (getf entry :command-file) :launcher-name launcher-name
                                :artifact-name (getf entry :artifact-name))))))
              entries))))

(defun %hub-repair-finish-plan (plan action reason)
  (setf (getf plan :action) action
        (getf plan :blocked-p) (eq action :blocked)
        (getf plan :reason) reason)
  plan)

(defun %hub-repair-path-issue (path directory-p)
  (%with-hub-diagnostic-probes
    (cond
      ((%hub-diagnostic-test "-L" path) "unsafe-path")
      ((%hub-diagnostic-test "-e" path)
       (cond
         ((not (%hub-diagnostic-test (if directory-p "-d" "-f") path)) "unsafe-path")
         ((or (not (%hub-diagnostic-test "-r" path))
              (and directory-p (not (%hub-diagnostic-test "-x" path)))) "read-error")))
      (t
       ;; An accessible existing path already proves traversal. Only missing
       ;; leaves need an ancestor check, batched into one read-only snapshot.
       (let* ((pathname (han.path:->pathname path))
              (parents (loop for parts = (pathname-directory pathname) then (butlast parts)
                             while parts collect (make-pathname :directory parts :name nil :type nil
                                                                 :version nil :defaults pathname))))
         (%hub-diagnostic-prime "properties"
          (remove-if (lambda (parent) (gethash (%hub-diagnostic-path-key parent) *hub-diagnostic-properties*)) parents))
         (when (some (lambda (parent) (and (%hub-diagnostic-test "-d" parent)
                                           (not (%hub-diagnostic-test "-x" parent)))) parents)
           "read-error"))))))

(defun %hub-repair-entry-path-issue (entry scope home bin)
  (let* ((metadata (getf entry :metadata))
         (declared-scope (han.json:get-json metadata "scope" :missing))
         (name (getf entry :package-name))
         (version (getf entry :version-id))
         (artifact (getf entry :artifact-name))
         (command (getf entry :command-base))
         (expected (%hub-install-paths home name version artifact
                                       :bin-dir bin :command-name command)))
    (unless (or (eq declared-scope :missing)
                (equal declared-scope (string-downcase (string scope))))
      (return-from %hub-repair-entry-path-issue "scope-mismatch"))
    (unless (and command (%hub-repair-optional-string-p metadata "command_name")
                 (or (null (%hub-repair-string metadata "command_name"))
                     (equal command (%hub-repair-string metadata "command_name"))))
      (return-from %hub-repair-entry-path-issue "identity-mismatch"))
    (when (%hub-installed-path-problem entry)
      (return-from %hub-repair-entry-path-issue "unsafe-path"))
    ;; Bind destinations to the caller's scope/bin, not metadata's claimed scope.
    (dolist (key '(:metadata-file :install-root :source-dir :bin-dir
                   :launcher-file :command-launcher-file))
      (when (or (getf entry key) (not (eq key :command-launcher-file)))
        (let ((directory-p (member key '(:install-root :source-dir :bin-dir))))
          (unless (equal (%hub-installed-path-key (getf entry key) directory-p)
                         (%hub-installed-path-key (getf expected key) directory-p))
            (return-from %hub-repair-entry-path-issue "unsafe-path")))))
    (dolist (pair (list (list (%taffish-home-dir home "apps") t)
                       (list (%taffish-home-dir home (format nil "apps/~A" name)) t)
                       (list (getf expected :install-root) t)
                       (list (getf expected :metadata-file) nil)
                       (list (getf expected :source-dir) t)
                       (list (han.path:join-path (getf expected :source-dir) "target/") t)
                       (list (getf entry :command-file) nil)
                       (list bin t)
                       (list (getf expected :launcher-file) nil)
                       (list (getf expected :command-launcher-file) nil)))
      (let ((issue (%hub-repair-path-issue (first pair) (second pair))))
        (when issue (return-from %hub-repair-entry-path-issue issue))))
    nil))

(defun %hub-repair-resolve (home query version-id index-record)
  (if index-record
      (let* ((name (%hub-repair-string index-record "name"))
             (version (%hub-install-record-version-id index-record nil))
             (command (%hub-install-command-name index-record))
             (artifact (%hub-install-artifact-name index-record version)))
        (unless (and (member query (list name command artifact) :test #'equal)
                     (or (null version-id)
                         (equal (%hub-normalize-version-id version-id) version)))
          (return-from %hub-repair-resolve nil))
        (list :query query :query-kind (cond ((equal query name) :package)
                                            ((equal query command) :command)
                                            (t :artifact))
              :package-name name :version-id version :record index-record))
      (%hub-resolve-info-target (%hub-load-index home "install --repair")
                                query version-id "install --repair")))

(defun %hub-repair-plan-one (&key query version-id (scope :user)
                                user-home system-home system-bin-dir index-record
                                (installed-entries nil installed-entries-p))
  "Classify one resolved index target without installing or repairing anything.
INDEX-RECORD is a version record, not a package/index object. Supplied entries
and diagnostic probes are snapshots for this read-only batch only. Apply must
replan with fresh entries/probes. Missing installations are always blocked here;
the --all caller alone may count not-installed as skipped-not-installed."
  (let ((plan (list :query query :requested-version-id version-id
                    :action :blocked :blocked-p t :reason "inspection-failed"
                    :entry nil :resolved-result nil :validation nil :validations nil
                    :scope scope :home nil :bin-dir nil :preconditions nil)))
    (labels ((blocked (reason)
               (return-from %hub-repair-plan-one
                 (%hub-repair-finish-plan plan :blocked reason))))
      (handler-case
          (%with-hub-diagnostic-probes
            (unless (and (%hub-repair-path-part-p query)
                         (or (null version-id) (%hub-repair-path-part-p version-id)))
              (blocked "invalid-target"))
            (let* ((normalized-scope (%normalize-taffish-scope scope))
                   (raw-home (han.path:absolute-pathname
                              (%taffish-home :scope normalized-scope
                                             :user-home user-home :system-home system-home)))
                   (raw-bin (han.path:absolute-pathname
                             (%taffish-command-bin-dir normalized-scope raw-home system-bin-dir)))
                   (home (progn
                           ;; Canonicalization must not erase an unsafe leaf link.
                           ;; Ancestor aliases such as /tmp and /var remain valid.
                           (when (or (%hub-diagnostic-test "-L" raw-home)
                                     (%hub-diagnostic-test "-L" raw-bin))
                             (blocked "unsafe-path"))
                           (%hub-installed-path-key raw-home t)))
                   (bin (%hub-installed-path-key raw-bin t))
                   (resolved (handler-case (%hub-repair-resolve home query version-id index-record)
                               (error () (blocked "index-target-invalid")))))
              (setf (getf plan :scope) normalized-scope
                    (getf plan :home) home (getf plan :bin-dir) bin
                    (getf plan :user-home) (%directory-namestring (%taffish-user-home user-home))
                    (getf plan :system-home) (%directory-namestring (%taffish-system-home system-home)))
              (unless resolved (blocked "identity-mismatch"))
              (let* ((record (getf resolved :record))
                     (name (getf resolved :package-name))
                     (version (getf resolved :version-id))
                     (command (%hub-repair-string (%hub-json-ref record "command") "name"))
                     (release (%hub-json-ref record "release"))
                     (artifact (%hub-install-artifact-name record version)))
                (unless (and (every #'%hub-repair-path-part-p (list name version command artifact))
                             (equal name (%hub-repair-string record "name"))
                             (member (%hub-repair-string record "kind") '("tool" "flow") :test #'equal)
                             (integerp release) (plusp release)
                             (%hub-repair-string record "version")
                             (equal version (format nil "~A-r~A" (%hub-repair-string record "version") release))
                             (equal version (%hub-install-record-version-id record version)))
                  (blocked "identity-mismatch"))
                (let* ((paths (%hub-install-paths home name version artifact :bin-dir bin :command-name command))
                       (root (getf paths :install-root))
                       (metadata-file (getf paths :metadata-file))
                       (entry nil))
                  (setf resolved (append (list :scope normalized-scope :home home
                                              :artifact-name artifact :command-name command
                                              :command-file (han.path:->namestring
                                                             (han.path:join-path
                                                              (getf paths :source-dir) "target/" artifact))
                                              :origin-kind :hub-index :origin name :installed-p t
                                              :source-url nil :source-ref nil :source-commit nil)
                                        paths resolved)
                        (getf plan :resolved-result) resolved
                        (getf plan :package-name) name (getf plan :version-id) version
                        (getf plan :artifact-name) artifact (getf plan :command-name) command)
                  (let ((pending (%hub-repair-unfinished-journal home name version)))
                    (when pending
                      (setf (getf plan :journal) pending)
                      (blocked "recovery-required")))
                  ;; Check the actual target before enumeration: broken records must
                  ;; not disappear into the same classification as absent apps.
                  (dolist (pair (list (list (%taffish-home-dir home "apps") t)
                                     (list (%taffish-home-dir home (format nil "apps/~A" name)) t)
                                     (list root t) (list metadata-file nil)))
                    (let ((issue (%hub-repair-path-issue (first pair) (second pair))))
                      (when issue (blocked issue))))
                  (unless (%hub-diagnostic-test "-e" root) (blocked "not-installed"))
                  (unless (%hub-diagnostic-test "-f" metadata-file) (blocked "metadata-invalid"))
                  (setf entry (or (find-if (lambda (e)
                                            (and (equal name (getf e :package-name))
                                                 (equal version (getf e :version-id))
                                                 (equal metadata-file
                                                        (%hub-installed-path-key
                                                         (getf e :metadata-file) nil))))
                                          installed-entries)
                                  (%hub-uninstall-read-entry home metadata-file)))
                  (unless entry (blocked "metadata-invalid"))
                  (setf entry (copy-list entry) (getf plan :entry) entry)
                  (let* ((metadata (getf entry :metadata))
                         (schema (han.json:get-json metadata "schema_version" :missing))
                         (repository (%hub-repair-string record "repository_url"))
                         (source (%hub-json-ref record "source"))
                         (commit (%hub-json-ref source "commit"))
                         (old-commit (%hub-repair-string metadata "source_commit"))
                         (source-url (%hub-install-source-url record)))
                    (unless (or (eq schema :missing) (equal schema "taffish.install/v1"))
                      (blocked "unknown-schema"))
                    (unless (and (equal name (getf entry :package-name))
                                 (equal name (%hub-repair-string metadata "name"))
                                 (equal version (getf entry :version-id))
                                 (equal artifact (getf entry :artifact-name))
                                 (%hub-repair-optional-string-p metadata "kind")
                                 (or (null (%hub-repair-string metadata "kind"))
                                     (equal (%hub-repair-string metadata "kind")
                                            (%hub-repair-string record "kind"))))
                      (blocked "identity-mismatch"))
                    (let ((issue (%hub-repair-entry-path-issue entry normalized-scope home bin)))
                      (when issue (blocked issue)))
                    (unless (equal (%hub-repair-string metadata "origin_kind") "hub-index")
                      (blocked "private-or-unknown-source"))
                    (unless (and (or (null source) (eq source :null) (han.json:json-object-p source))
                                 (every (lambda (key) (%hub-repair-optional-string-p source key))
                                        '("local_path" "clone_url" "repository_url" "ref"))
                                 (every (lambda (key) (%hub-repair-optional-string-p metadata key))
                                        '("source_url" "source_commit" "source_commit_actual")))
                      (blocked "source-conflict"))
                    (unless (and repository (equal repository (%hub-repair-string metadata "repository_url"))
                                 (%hub-non-empty-string-p source-url)
                                 (or (null (%hub-repair-string metadata "source_url"))
                                     (equal source-url (%hub-repair-string metadata "source_url"))))
                      (blocked "source-conflict"))
                    (when (or (eq commit :null) (equal commit "")) (setf commit nil))
                    (when (and commit (not (%hub-repair-commit-p commit)))
                      (blocked "invalid-source-commit"))
                    (when (and commit old-commit (not (string-equal commit old-commit)))
                      (blocked "source-commit-conflict"))
                    (let ((actual (%hub-repair-string metadata "source_commit_actual")))
                      (when (and actual (or commit old-commit)
                                 (not (string-equal actual (or commit old-commit))))
                        (blocked "source-commit-conflict")))
                    (setf (getf entry :command-launcher-file) (getf paths :command-launcher-file))
                    (let* ((snapshot (han.path:join-path (getf entry :source-dir) "target/"
                                                         (format nil ".~A/" artifact)))
                           (manifest (%build-manifest-file snapshot)))
                      (dolist (pair (list (list snapshot t) (list manifest nil)))
                        (let ((issue (%hub-repair-path-issue (first pair) (second pair))))
                          (when issue (blocked issue))))
                      (when (and (%hub-diagnostic-test "-d" snapshot)
                                 (%hub-diagnostic-tree-issues snapshot))
                        (blocked "unsafe-or-unreadable"))
                      ;; A missing wrapper must not hide a future manifest schema.
                      (when (%hub-diagnostic-test "-f" manifest)
                        (multiple-value-bind (object problem) (%hub-diagnostic-json manifest "manifest-invalid")
                          (when (and problem (eq (getf problem :state) :unknown)) (blocked "read-error"))
                          (when (and object (han.json:json-object-p object)
                                     (not (equal (%hub-json-ref object "schema") *build-manifest-schema*)))
                            (blocked "unknown-schema")))))
                    (let* ((entries (if installed-entries-p installed-entries
                                        (%hub-uninstall-installed-entries home)))
                           (group (remove-if-not
                                   (lambda (e)
                                     (and (equal command (getf e :command-base))
                                          (equal bin (%hub-installed-path-key (getf e :bin-dir) t))))
                                   entries))
                           (validation (%hub-diagnose-entry entry)))
                      (unless (find (getf entry :metadata-file) group :test #'equal
                                    :key (lambda (e) (getf e :metadata-file)))
                        (push entry group))
                      (dolist (candidate group)
                        (unless (equal name (getf candidate :package-name)) (blocked "command-conflict")))
                      ;; Diagnostics can stop at a missing wrapper, so establish
                      ;; entry ownership independently before authorizing repair.
                      (unless (%hub-repair-launcher-owned-p (getf entry :launcher-file) artifact (list entry))
                        (blocked "launcher-unrecognized"))
                      (unless (%hub-repair-launcher-owned-p (getf entry :command-launcher-file) command group)
                        (blocked "alias-unrecognized"))
                      (let* ((aliases (%hub-diagnose-aliases group (list entry)))
                             (validations (cons validation aliases))
                             (issues (loop for item in validations append (getf item :issues))))
                        (setf (getf plan :validation) validation (getf plan :validations) validations
                              (getf resolved :source-url) source-url
                              (getf resolved :source-ref) (%hub-install-source-ref record version)
                              (getf resolved :source-commit) commit
                              (getf plan :preconditions)
                              (list :metadata-sha256 (%project-sha256-file metadata-file)
                                    :record-sha256 (%project-sha256-string (han.json:encode-json record))
                                    :source-commit commit))
                        (when (find :unknown issues :key (lambda (issue) (getf issue :state)))
                          (blocked (if (find-if (lambda (i) (member (getf i :code)
                                                                   '("metadata-schema" "manifest-schema") :test #'equal)) issues)
                                       "unknown-schema" "unsafe-or-unreadable")))
                        (when (find "identity-mismatch" issues :test #'equal :key (lambda (i) (getf i :code)))
                          (blocked "identity-mismatch"))
                        (cond
                          ((every (lambda (v) (eq (getf v :state) :verified)) validations)
                           (%hub-repair-finish-plan plan :skip "already-verified"))
                          ((null commit) (blocked "missing-fixed-commit"))
                          (t (%hub-repair-finish-plan plan :repair "rebuild-required"))))))))))
        (error (condition)
          (setf (getf plan :detail) (princ-to-string condition))
          (%hub-repair-finish-plan plan :blocked "inspection-failed"))))))

;;;; No automatic stale-lock stealing or journal replay. Interrupted transactions
;;;; retain their owner record, intent journal, backups, and failed artifacts.

(defvar *hub-write-lock-token* nil)
(defvar *hub-repair-transaction-test-hook* nil)
(defvar *hub-repair-active-journal* nil)

(dolist (entry
         '(("write-lock-busy" "A writer lock already exists; inspect its owner before manual recovery." "写锁已存在；手动恢复前请核对锁所有者。")
           ("write-lock-upgrade" "A nested write cannot change the locked home/bin resources." "嵌套写操作不能改变已锁定的 home/bin 资源。")
           ("write-lock-lost" "Writer lock ownership changed; writes have stopped." "写锁所有权发生变化；已停止写入。")
           ("write-lock-required" "Repair apply must run inside the matching home/bin writer lock." "执行修复必须持有匹配 home/bin 的写锁。")
           ("write-lock-release" "Writer lock cleanup failed; inspect the retained lock before retrying." "写锁清理失败；重试前请检查保留的锁。")
           ("plan-changed" "Installation or index evidence changed; discard the old plan and preview again." "安装或索引证据已变化；请丢弃旧计划并重新预览。")
           ("source-fetch-failed" "Fetching or checking out the fixed source commit failed." "获取或检出固定源码 commit 失败。")
           ("stage-invalid" "The staged source or build did not pass identity and integrity checks." "暂存源码或构建未通过身份与完整性检查。")
           ("filesystem-operation" "A filesystem operation failed; retained recovery materials must be inspected." "文件系统操作失败；请检查保留的恢复材料。")
           ("repair-failed" "Repair failed; the old installation was retained or restored, and recovery materials were kept." "修复失败；旧安装已保留或恢复，恢复材料亦已保留。")
           ("recovery-required" "Automatic rollback could not safely finish; preserve the journal and all backup paths for manual recovery." "自动回滚无法安全完成；请保留日志及所有备份路径以便手动恢复。")
           ("final-validation-failed" "The switched installation did not pass fresh validation." "切换后的安装未通过重新验证。")))
  (destructuring-bind (reason english chinese) entry
    (taffish.i18n:register-message (concatenate 'string "taf.hub.repair.reason." reason) english chinese)))

(define-condition hub-repair-error (error)
  ((reason :initarg :reason :reader %hub-repair-error-reason)
   (journal :initarg :journal :initform nil :reader %hub-repair-error-journal)
   (detail :initarg :detail :initform nil :reader %hub-repair-error-detail))
  (:report (lambda (condition stream)
             (format stream "~A [~A]~@[ (~A)~]~@[: ~A~]"
                     (%hub-message (concatenate 'string "repair.reason." (%hub-repair-error-reason condition)))
                     (%hub-repair-error-reason condition) (%hub-repair-error-journal condition)
                     (%hub-repair-error-detail condition)))))

(defun %hub-repair-fail (reason &optional journal detail)
  (error 'hub-repair-error :reason reason :journal journal :detail detail))

(defmacro %with-hub-repair-fresh-probes (&body body)
  `(let ((*hub-diagnostic-properties* nil) (*hub-diagnostic-listings* nil))
     (%with-hub-diagnostic-probes ,@body)))

(defun %hub-repair-token ()
  (format nil "~36R-~D-~36R" (get-universal-time) (han.host:current-process-id) (random (expt 2 128))))

(defun %hub-repair-present-p (path)
  (%with-hub-repair-fresh-probes
    (or (%hub-diagnostic-test "-e" path) (%hub-diagnostic-test "-L" path))))

(defun %hub-repair-check-path (path directory-p &optional required-p)
  (%with-hub-repair-fresh-probes
    (let ((issue (%hub-repair-path-issue path directory-p)))
      (when issue (%hub-repair-fail issue nil (han.path:->namestring path)))
      (when (and required-p (not (%hub-diagnostic-test "-e" path)))
        (%hub-repair-fail "filesystem-operation" nil (han.path:->namestring path)))))
  path)

(defun %hub-repair-run (program arguments)
  (let ((executable (%hub-diagnostic-program program)))
    (unless executable (%hub-repair-fail "filesystem-operation" nil program))
    (multiple-value-bind (out err code) (han.os:run-program (cons executable arguments))
      (unless (eql code 0)
        (%hub-repair-fail "filesystem-operation" nil (format nil "~A: ~A~A" program out err)))
      out)))

(defun %hub-repair-mode-string (directory)
  ;; POSIX ls permission columns avoid GNU/BSD-specific stat switches.
  (%hub-repair-check-path directory t t)
  (let ((text (%hub-repair-run "ls" (list "-ld" (han.path:->namestring directory))))
        (mode 0))
    (unless (and (>= (length text) 10) (char= (char text 0) #\d))
      (%hub-repair-fail "filesystem-operation"))
    (loop for offset in '(1 4 7) for shift in '(6 3 0) do
      (let ((bits 0))
        (when (char= (char text offset) #\r) (incf bits 4))
        (when (char= (char text (+ offset 1)) #\w) (incf bits 2))
        (when (find (char text (+ offset 2)) "xst") (incf bits 1))
        (incf mode (ash bits shift))))
    (when (find (char text 3) "sS") (incf mode #o4000))
    (when (find (char text 6) "sS") (incf mode #o2000))
    (when (find (char text 9) "tT") (incf mode #o1000))
    (format nil "~4,'0O" mode)))

(defun %hub-repair-mkdir-exclusive (path &optional (failure-reason "filesystem-operation"))
  (handler-case (%hub-repair-run "mkdir" (list "-m" "700" (han.path:->namestring path)))
    (error (condition) (%hub-repair-fail failure-reason nil (princ-to-string condition))))
  (%hub-repair-check-path path t t))

(defun %hub-repair-lock-resources (home bin)
  (sort (remove-duplicates
         (mapcar (lambda (path) (%hub-installed-path-key (han.path:absolute-pathname path) t))
                 (cons home (if (listp bin) bin (list bin)))) :test #'equal)
        #'string<))

(defun %hub-repair-lock-covers-p (home bin)
  (and *hub-write-lock-token*
       (equal (%hub-installed-path-key (han.path:absolute-pathname home) t)
              (getf *hub-write-lock-token* :home))
       (subsetp (%hub-repair-lock-resources home bin)
                (getf *hub-write-lock-token* :resources) :test #'equal)))

(defun %hub-repair-check-lock-owner ()
  (%with-hub-repair-fresh-probes
    (%hub-diagnostic-prime "properties"
     (loop for lock in (getf *hub-write-lock-token* :locks)
           append (list (getf lock :directory) (getf lock :owner-file))))
    (unless (and *hub-write-lock-token*
               (every (lambda (lock)
                        (handler-case
                            (progn
                              (and (null (%hub-repair-path-issue (getf lock :directory) t))
                                   (null (%hub-repair-path-issue (getf lock :owner-file) nil))
                                   (%hub-diagnostic-test "-f" (getf lock :owner-file))
                                   (equal (han.json:get-json (han.json:read-json-file (getf lock :owner-file)) "token")
                                          (getf *hub-write-lock-token* :token))))
                          (error () nil)))
                      (getf *hub-write-lock-token* :locks)))
      (%hub-repair-fail "write-lock-lost"))))

(defun %hub-call-with-write-locks (home bin thunk)
  "Exclude writers sharing home or any BIN (a path or list of paths).
Reentry may request only a subset of the already locked resources in this home.
Callers must bypass this function for dry runs and missing-target no-ops."
  (let ((resources (%hub-repair-lock-resources home bin))
        (*hub-diagnostic-programs* (or *hub-diagnostic-programs* (make-hash-table :test #'equal))))
    (when *hub-write-lock-token*
      (unless (%hub-repair-lock-covers-p home bin)
        (%hub-repair-fail "write-lock-upgrade"))
      (%hub-repair-check-lock-owner)
      (%hub-repair-check-unfinished (getf *hub-write-lock-token* :home))
      (return-from %hub-call-with-write-locks (funcall thunk)))
    (let* ((token (%hub-repair-token))
           (*hub-write-lock-token* (list :resources resources :token token :locks nil
                                         :home (%hub-installed-path-key (han.path:absolute-pathname home) t)))
           (finished nil) (release-errors nil))
      (unwind-protect
           (progn
             (dolist (resource (sort (remove-duplicates (copy-list resources) :test #'equal) #'string<))
               (%hub-repair-check-path resource t)
               (ensure-directories-exist (han.path:directory-pathname resource))
               (unless (equal resource (%hub-installed-path-key resource t))
                 (%hub-repair-fail "unsafe-path"))
               (let* ((directory (han.path:join-path resource ".taffish-write.lock/"))
                      (owner-file (han.path:join-path directory "owner.json"))
                      (lock (list :directory directory :owner-file owner-file)))
                 (%hub-repair-mkdir-exclusive directory "write-lock-busy")
                 ;; Track acquisition before writing the owner record.
                 (push lock (getf *hub-write-lock-token* :locks))
                 (han.json:write-json-file owner-file
                  (han.json:json-object (cons "schema" "taffish.write-lock/v1") (cons "token" token)
                   (cons "pid" (han.host:current-process-id)) (cons "host" (machine-instance))
                   (cons "created_at" (%hub-timestamp)) (cons "home" (getf *hub-write-lock-token* :home))
                   (cons "resources" (coerce resources 'vector)) (cons "resource" resource)))))
             (%hub-repair-check-lock-owner)
             (%hub-repair-check-unfinished (getf *hub-write-lock-token* :home))
             (multiple-value-prog1 (funcall thunk) (setf finished t)))
        (dolist (lock (getf *hub-write-lock-token* :locks))
          (handler-case
              (let ((owner (getf lock :owner-file)))
                (%hub-repair-check-path (getf lock :directory) t t)
                (when (%hub-repair-present-p owner)
                  (%hub-repair-check-path owner nil t)
                  (unless (equal token (han.json:get-json (han.json:read-json-file owner) "token"))
                    (%hub-repair-fail "write-lock-lost"))
                  (delete-file owner))
                (%hub-repair-run "rmdir" (list (han.path:->namestring (getf lock :directory)))))
            (error (condition) (push condition release-errors))))
        (when (and finished release-errors)
          (%hub-repair-fail "write-lock-release" nil (princ-to-string (first release-errors))))))))

(defun %hub-repair-digest (file)
  (%hub-repair-check-path file nil)
  (if (%hub-repair-present-p file) (%project-sha256-file file) :missing))

(defun %hub-repair-observation (plan)
  (let ((entry (getf plan :entry)))
    (append (getf plan :preconditions)
            (loop for key in '(:command-file :launcher-file :command-launcher-file)
                  append (list key (%hub-repair-digest (getf entry key)))))))

(defun %hub-repair-replan (plan)
  (%with-hub-repair-fresh-probes
    (%hub-repair-plan-one :query (getf plan :package-name) :version-id (getf plan :version-id)
                         :scope (getf plan :scope) :user-home (getf plan :user-home)
                         :system-home (getf plan :system-home) :system-bin-dir (getf plan :bin-dir))))

(defun %hub-repair-unfinished-journal (home &optional package version)
  "Return an unfinished/unknown journal, or NIL. Never replay or alter it."
  (let ((parent (han.path:join-path home ".repair/")))
    (handler-case
        (%with-hub-diagnostic-probes
          (when (%hub-repair-path-issue parent t)
            (return-from %hub-repair-unfinished-journal (han.path:->namestring parent)))
          (when (%hub-diagnostic-test "-d" parent)
            (dolist (directory (%hub-diagnostic-children parent))
              (when (or (%hub-repair-path-issue directory t)
                        (not (%hub-diagnostic-test "-d" directory)))
                (return-from %hub-repair-unfinished-journal (han.path:->namestring directory)))
              (let ((journal (han.path:join-path directory "journal.json")))
                (unless (and *hub-repair-active-journal*
                             (equal (%hub-installed-path-key journal nil)
                                    (%hub-installed-path-key *hub-repair-active-journal* nil)))
                  (let ((record (and (not (%hub-repair-path-issue journal nil))
                                     (%hub-diagnostic-test "-f" journal)
                                     (ignore-errors (han.json:read-json-file journal)))))
                    (when (or (not (equal (han.json:get-json record "schema") "taffish.repair/v1"))
                              (not (equal (han.json:get-json record "home") home))
                              (and (or (null package) (equal package (han.json:get-json record "package")))
                                   (or (null version) (equal version (han.json:get-json record "version_id")))
                                   (not (member (han.json:get-json record "status")
                                                '("committed" "rolled-back" "failed-before-switch") :test #'equal))))
                      (return-from %hub-repair-unfinished-journal (han.path:->namestring journal)))))))))
      (error () (han.path:->namestring parent)))))

(defun %hub-repair-check-unfinished (home)
  "Batch preflight must call this even if --all finds no installed directories."
  (%with-hub-repair-fresh-probes
    (let ((journal (%hub-repair-unfinished-journal
                    (%hub-installed-path-key (han.path:absolute-pathname home) t))))
      (when journal (%hub-repair-fail "recovery-required" journal)))))

(defun %hub-repair-rename (source target directory-p &optional replace-p)
  (%hub-repair-check-path source directory-p t)
  (%hub-repair-check-path target directory-p)
  (when (and (%hub-repair-present-p target) (or directory-p (not replace-p)))
    (%hub-repair-fail "filesystem-operation" nil (format nil "Destination exists: ~A" target)))
  ;; No copy fallback: cross-filesystem roots must fail before losing the old root.
  (if (and replace-p (not directory-p))
      (flet ((native-name (path)
               (etypecase path
                 (string path)
                 (pathname (han.path:->namestring path)))))
        (han.host:atomic-replace-file (native-name source) (native-name target)))
      (%rename-to-exact-path source target directory-p))
  (%hub-repair-check-path target directory-p t)
  (when (%hub-repair-present-p source) (%hub-repair-fail "filesystem-operation" nil (han.path:->namestring source))))

(defun %hub-repair-copy (source target directory-p)
  (%hub-repair-check-path source directory-p t)
  (when (%hub-repair-present-p target) (%hub-repair-fail "filesystem-operation" nil (han.path:->namestring target)))
  ;; Preserve modes and symlinks as data in the old root; never follow them.
  (%hub-repair-run "cp" (list (if directory-p "-pRP" "-pP")
                              (han.path:->namestring source) (han.path:->namestring target)))
  (%hub-repair-check-path target directory-p t))

(defun %hub-repair-journal-phase (transaction phase)
  (let* ((object (getf transaction :journal-object))
         (file (getf transaction :journal))
         (temporary (han.path:join-path (getf transaction :directory)
                                        (format nil "journal-~A.tmp" (%hub-repair-token)))))
    (setf (gethash "phase" object) phase (gethash "updated_at" object) (%hub-timestamp))
    (han.json:write-json-file temporary object :indent 2)
    (%hub-repair-rename temporary file nil t)
    (when *hub-repair-transaction-test-hook*
      (funcall *hub-repair-transaction-test-hook* phase transaction))))

(defun %hub-repair-git (arguments prompt-p)
  (multiple-value-bind (out err code)
      (%hub-install-run-program (%publish-git-program)
       (append '("-c" "core.hooksPath=/dev/null" "-c" "advice.detachedHead=false"
                 "-c" "protocol.ext.allow=never") arguments)
       :noninteractive (not prompt-p) :prompt prompt-p :verbose nil)
    (unless (eql code 0) (%hub-repair-fail "source-fetch-failed" nil (format nil "~A~A" out err)))
    out))

(defun %hub-repair-clone-fixed (url commit source prompt-p)
  (unless (and (%hub-repair-commit-p commit) (%hub-non-empty-string-p url)
               (or (%hub-install-git-source-p url) (%hub-install-local-source-dir url)))
    (%hub-repair-fail "source-conflict"))
  (when (%hub-repair-present-p source) (%hub-repair-fail "unsafe-path"))
  (%hub-repair-git (list "clone" "--no-checkout" "--no-local" "--template=" "--"
                         url (han.path:->namestring source)) prompt-p)
  (%hub-repair-git (list "-C" (han.path:->namestring source) "checkout" "--detach" commit) nil)
  (%hub-install-verify-source-commit source commit :source-url url :source-ref commit))

(defun %hub-repair-check-source-tree (source)
  (%with-hub-repair-fresh-probes
    (%hub-repair-check-path source t t)
    (dolist (child (%hub-diagnostic-children source))
      (when (%hub-diagnostic-test "-L" child) (%hub-repair-fail "unsafe-path"))
      (cond
        ((%hub-diagnostic-test "-d" child)
         (unless (equal (%directory-leaf-name child) ".git")
           (when (%hub-diagnostic-tree-issues child) (%hub-repair-fail "unsafe-or-unreadable"))))
        ((%hub-diagnostic-file-issues child) (%hub-repair-fail "unsafe-or-unreadable"))))))

(defun %hub-repair-check-project (project result)
  (let ((record (getf result :record)))
    (unless (and (equal (getf project :name) (getf result :package-name))
                 (equal (getf project :command-name) (getf result :command-name))
                 (equal (%build-artifact-name project) (getf result :artifact-name))
                 (equal (string-downcase (string (getf project :kind))) (%hub-json-string record "kind"))
                 (equal (getf project :repository-url) (%hub-json-string record "repository_url")))
      (%hub-repair-fail "identity-mismatch"))))

(defun %hub-repair-build-stage (source result plan)
  (%hub-repair-check-source-tree source)
  (%hub-repair-check-project (project-check source nil nil) result)
  (let* ((build (project-build :start-dir source :command-p t :image-p nil :verbose nil
                              :user-home (getf plan :user-home) :system-home (getf plan :system-home)))
         (project (getf build :project)) (command (getf build :command))
         (artifact (getf result :artifact-name))
         (wrapper (han.path:join-path source "target/" artifact))
         (snapshot (han.path:join-path source "target/" (format nil ".~A/" artifact))))
    (%hub-repair-check-project project result)
    (%hub-repair-check-source-tree source)
    (unless (and (equal (%hub-installed-path-key wrapper nil)
                        (%hub-installed-path-key (getf command :command-file) nil))
                 (%build-artifacts-current-p artifact wrapper snapshot
                   (%build-snapshot-digest snapshot)
                   (%project-sha256-string (%make-build-wrapper-string
                                            project (format nil ".~A" artifact) (getf project :main-path) artifact))))
      (%hub-repair-fail "stage-invalid"))
    build))

(defun %hub-repair-alias-target (plan)
  (let ((selected (getf plan :entry)) (candidates nil))
    (dolist (entry (cons selected (%hub-uninstall-installed-entries (getf plan :home))))
      (when (and (equal (getf entry :command-base) (getf selected :command-base))
                 (equal (%hub-installed-path-key (getf entry :bin-dir) t) (getf plan :bin-dir))
                 (or (eq entry selected) (han.path:file-exists-p (getf entry :command-file))))
        (when (%hub-installed-path-problem entry) (%hub-repair-fail "unsafe-path"))
        (push entry candidates)))
    (%hub-install-latest-command-entry candidates)))

(defun %hub-repair-new-transaction (plan)
  (let* ((token (%hub-repair-token)) (home (getf plan :home)) (bin (getf plan :bin-dir))
         (parent (han.path:join-path home ".repair/"))
         (directory (han.path:join-path parent (format nil "~A/" token)))
         (bin-directory (han.path:join-path bin (format nil ".taffish-repair-~A/" token)))
         (result (getf plan :resolved-result))
         (object (han.json:json-object
                   (cons "schema" "taffish.repair/v1") (cons "transaction_id" token)
                   (cons "owner_token" (getf *hub-write-lock-token* :token))
                   (cons "pid" (han.host:current-process-id)) (cons "created_at" (%hub-timestamp))
                   (cons "scope" (string-downcase (string (getf plan :scope))))
                   (cons "home" home) (cons "bin" bin) (cons "package" (getf plan :package-name))
                   (cons "version_id" (getf plan :version-id)) (cons "artifact" (getf plan :artifact-name))
                   (cons "command" (getf plan :command-name))
                   (cons "source_commit" (getf result :source-commit))
                   (cons "source_url" (getf result :source-url))
                   (cons "record_sha256" (getf (getf plan :preconditions) :record-sha256))
                   (cons "old_metadata_sha256" (getf (getf plan :preconditions) :metadata-sha256))
                   (cons "old_root_mode" (%hub-repair-mode-string (getf result :install-root)))
                   (cons "old_root_moved" nil) (cons "new_root_placed" nil)
                   (cons "status" "preparing")))
         (transaction (list :directory directory :bin-directory bin-directory :journal-object object
                            :journal (han.path:join-path directory "journal.json")
                            :plan plan :result result :entries nil)))
    (%hub-repair-check-path parent t)
    (unless (%hub-repair-present-p parent) (%hub-repair-mkdir-exclusive parent))
    (%hub-repair-mkdir-exclusive directory)
    (dolist (pair `((:root ,(getf result :install-root))
                    (:stage-root ,(han.path:join-path directory "stage-root/"))
                    (:backup-root ,(han.path:join-path directory "backup-root/"))
                    (:rollback-root ,(han.path:join-path directory "rollback-root/"))
                    (:failed-root ,(han.path:join-path directory "failed-root/"))
                    (:bin-directory ,bin-directory)))
      (setf (getf transaction (first pair)) (second pair)
            (gethash (string-downcase (string (first pair))) object) (han.path:->namestring (second pair))))
    (%hub-repair-journal-phase transaction "created")
    (%hub-repair-mkdir-exclusive bin-directory)
    transaction))

(defun %hub-repair-prepare-entries (transaction alias-target)
  (let* ((result (getf transaction :result)) (directory (getf transaction :bin-directory))
         (objects nil))
    (dolist (spec (list (list "launcher" (getf result :launcher-file) (getf result :artifact-name)
                              (getf result :command-file) (getf result :artifact-name))
                        (list "alias" (getf result :command-launcher-file) (getf result :command-name)
                              (getf alias-target :command-file) (getf alias-target :artifact-name))))
      (destructuring-bind (role final name command artifact) spec
        (let* ((staged (han.path:join-path directory (format nil "~A.new" role)))
               (backup (han.path:join-path directory (format nil "~A.backup" role)))
               (object (han.json:json-object
                         (cons "role" role) (cons "final" final)
                         (cons "staged" (han.path:->namestring staged))
                         (cons "backup" (han.path:->namestring backup))
                         (cons "failed" (han.path:->namestring (han.path:join-path directory (format nil "~A.failed" role))))
                         (cons "restore" (han.path:->namestring (han.path:join-path directory (format nil "~A.restore" role))))
                         (cons "existed_before" (%hub-repair-present-p final))
                         (cons "old_sha256" (let ((hash (%hub-repair-digest final))) (if (eq hash :missing) :null hash)))
                         (cons "installed" nil))))
          (%hub-install-write-launcher staged command :launcher-name name :artifact-name artifact)
          (setf (gethash "new_sha256" object) (%project-sha256-file staged))
          (setf (gethash "unchanged" object)
                (and (equal (han.json:get-json object "old_sha256") (han.json:get-json object "new_sha256"))
                     (%with-hub-repair-fresh-probes (%hub-diagnostic-test "-x" final))))
          (when (and (han.json:get-json object "existed_before")
                     (not (han.json:get-json object "unchanged")))
            (%hub-repair-copy final backup nil)
            (unless (equal (%project-sha256-file backup) (han.json:get-json object "old_sha256"))
              (%hub-repair-fail "plan-changed")))
          (push object objects))))
    (setf (getf transaction :entries) (nreverse objects)
          (gethash "entries" (getf transaction :journal-object)) (coerce (getf transaction :entries) 'vector))
    (%hub-repair-journal-phase transaction "entries-prepared")))

(defun %hub-repair-rollback (transaction)
  (let* ((object (getf transaction :journal-object)) (root (getf transaction :root))
         (metadata (han.path:join-path root "install.json")))
    (%hub-repair-check-lock-owner)
    (%hub-repair-journal-phase transaction "rollback-intent")
    (when (han.json:get-json object "old_root_moved")
      (when (%hub-repair-present-p root)
        (unless (and (han.json:get-json object "new_root_placed")
                     (equal (%hub-repair-digest metadata) (han.json:get-json object "new_metadata_sha256")))
          (%hub-repair-fail "recovery-required"))
        (%hub-repair-rename root (getf transaction :failed-root) t))
      (%hub-repair-copy (getf transaction :backup-root) (getf transaction :rollback-root) t)
      (unless (equal (%hub-repair-digest (han.path:join-path (getf transaction :rollback-root) "install.json"))
                     (han.json:get-json object "old_metadata_sha256"))
        (%hub-repair-fail "recovery-required"))
      (%hub-repair-rename (getf transaction :rollback-root) root t)
      (%hub-repair-journal-phase transaction "rollback-root-restored"))
    (dolist (entry (getf transaction :entries))
      (when (han.json:get-json entry "installed")
        (let ((final (han.json:get-json entry "final")))
          (when (%hub-repair-present-p final)
            (unless (equal (%hub-repair-digest final) (han.json:get-json entry "new_sha256"))
              (%hub-repair-fail "recovery-required"))
            (%hub-repair-rename final (han.json:get-json entry "failed") nil))
          (when (han.json:get-json entry "existed_before")
            (%hub-repair-copy (han.json:get-json entry "backup") (han.json:get-json entry "restore") nil)
            (unless (equal (%hub-repair-digest (han.json:get-json entry "restore"))
                           (han.json:get-json entry "old_sha256"))
              (%hub-repair-fail "recovery-required"))
            (%hub-repair-rename (han.json:get-json entry "restore") final nil))
          (%hub-repair-journal-phase transaction (concatenate 'string "rollback-" (han.json:get-json entry "role") "-restored")))))
    (setf (gethash "status" object) "rolled-back")
    (%hub-repair-journal-phase transaction "rolled-back")))

(defun %hub-repair-apply-one (plan)
  "Apply one installed-identity repair under the caller's matching writer lock."
  (unless (%hub-repair-lock-covers-p (getf plan :home) (getf plan :bin-dir))
    (%hub-repair-fail "write-lock-required"))
  (%hub-repair-check-lock-owner)
  (let* ((fresh (%hub-repair-replan plan)) (result (getf fresh :resolved-result)))
    (when (getf fresh :blocked-p) (%hub-repair-fail (getf fresh :reason)))
    (when (eq (getf fresh :action) :skip)
      (return-from %hub-repair-apply-one
        (list :package-name (getf fresh :package-name) :version-id (getf fresh :version-id)
              :scope (getf fresh :scope) :action :skip :reason "already-verified")))
    (unless (equal (getf fresh :preconditions) (getf plan :preconditions))
      (%hub-repair-fail "plan-changed"))
    (let* ((observation (%hub-repair-observation fresh))
           (alias-target (%hub-repair-alias-target fresh))
           (transaction (%hub-repair-new-transaction fresh))
           (object (getf transaction :journal-object))
           (journal (getf transaction :journal))
           (*hub-repair-active-journal* journal)
           (source (han.path:join-path (getf transaction :stage-root) "source/")))
      (handler-case
          (progn
            (%hub-repair-mkdir-exclusive (getf transaction :stage-root))
            (let ((resolved-url (%resolve-taffish-source-url (getf result :source-url)
                                 :scope (getf fresh :scope) :user-home (getf fresh :user-home)
                                 :system-home (getf fresh :system-home))))
              (setf (gethash "resolved_source_url" object) resolved-url)
              (%operation-stage "fetch" :target (getf fresh :artifact-name))
              (%hub-repair-journal-phase transaction "clone-intent")
              (let ((actual (%hub-repair-clone-fixed resolved-url (getf result :source-commit) source (getf plan :prompt-p))))
                (setf result (append (list :resolved-source-url resolved-url :actual-source-commit actual
                                           :source-commit-verified-p t) result)
                      (getf transaction :result) result
                      (gethash "actual_source_commit" object) actual)))
            (%hub-repair-journal-phase transaction "source-verified")
            (%operation-stage "build" :target (getf fresh :artifact-name))
            (%hub-repair-build-stage source result fresh)
            (%hub-repair-journal-phase transaction "stage-built")
            (let ((metadata (han.path:join-path (getf transaction :stage-root) "install.json")))
              (han.json:write-json-file metadata (%hub-install-metadata-json result (getf result :record)) :indent 2)
              (setf (gethash "new_metadata_sha256" object) (%project-sha256-file metadata)))
            (%hub-repair-prepare-entries transaction alias-target)
            (%operation-stage "verify" :target (getf fresh :artifact-name))
            (let ((again (%hub-repair-replan fresh)))
              (unless (and (eq (getf again :action) :repair)
                           (equal observation (%hub-repair-observation again)))
                (%hub-repair-fail "plan-changed")))
            (%hub-repair-check-lock-owner)
            (%operation-stage "switch" :target (getf fresh :artifact-name))
            ;; The parent stays private, but the published root must retain the
            ;; old permissions (especially for system installs used by others).
            (%hub-repair-run "chmod" (list (han.json:get-json object "old_root_mode")
                                           (han.path:->namestring (getf transaction :stage-root))))
            (%hub-repair-journal-phase transaction "backup-root-intent")
            (%hub-repair-rename (getf transaction :root) (getf transaction :backup-root) t)
            (setf (gethash "old_root_moved" object) t)
            (%hub-repair-journal-phase transaction "root-backed-up")
            (%hub-repair-journal-phase transaction "switch-root-intent")
            (%hub-repair-rename (getf transaction :stage-root) (getf transaction :root) t)
            (setf (gethash "new_root_placed" object) t)
            (%hub-repair-journal-phase transaction "root-switched")
            (dolist (entry (getf transaction :entries))
              (unless (han.json:get-json entry "unchanged")
              (let* ((role (han.json:get-json entry "role")) (final (han.json:get-json entry "final"))
                     (old (han.json:get-json entry "old_sha256")))
                (unless (equal (%hub-repair-digest final) (if (eq old :null) :missing old))
                  (%hub-repair-fail "plan-changed"))
                (%hub-repair-check-lock-owner)
                (%hub-repair-journal-phase transaction (concatenate 'string role "-switch-intent"))
                (%hub-repair-rename (han.json:get-json entry "staged") final nil t)
                (setf (gethash "installed" entry) t)
                (%hub-repair-journal-phase transaction (concatenate 'string role "-switched")))))
            (%operation-stage "verify" :target (getf fresh :artifact-name))
            (unless (eq (getf (%hub-repair-replan fresh) :action) :skip)
              (%hub-repair-fail "final-validation-failed"))
            (%hub-repair-journal-phase transaction "final-verified")
            (setf (gethash "status" object) "committed")
            (%hub-repair-journal-phase transaction "committed")
            (list :package-name (getf fresh :package-name) :version-id (getf fresh :version-id)
                  :artifact-name (getf fresh :artifact-name) :scope (getf fresh :scope)
                  :action :repaired :reason "rebuild-required" :source-commit (getf result :source-commit)
                  :backup-root (han.path:->namestring (getf transaction :backup-root))
                  :backup-directory (han.path:->namestring (getf transaction :directory))
                  :entry-backup-dir (han.path:->namestring (getf transaction :bin-directory))
                  :journal (han.path:->namestring journal)))
        (error (condition)
          (setf (gethash "failure" object) (princ-to-string condition))
          (handler-case
              (if (han.json:get-json object "old_root_moved")
                  (%hub-repair-rollback transaction)
                  (progn (setf (gethash "status" object) "failed-before-switch")
                         (%hub-repair-journal-phase transaction "failed-before-switch")))
            (error (rollback-error)
              (setf (gethash "status" object) "recovery-required"
                    (gethash "rollback_failure" object) (princ-to-string rollback-error))
              (ignore-errors (%hub-repair-journal-phase transaction "recovery-required"))
              (%hub-repair-fail "recovery-required" journal (princ-to-string condition))))
          (%hub-repair-fail "repair-failed" journal (princ-to-string condition)))))))
