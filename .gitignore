# TAFFISH source repository ignore rules.
# Source, docs, installers, completions, vim files, and ASDF/load files are
# tracked by default. Generated local build/cache artifacts are ignored.

# OS/editor noise
.DS_Store
Thumbs.db
*~
*.bak
*.orig
*.tmp
*.swp
*.swo
\#*\#

# Python bytecode caches
__pycache__/
*.pyc

# Logs and local scratch files
*.log
*.out
*.err
.cache/
tmp/
temp/
.local/

# Common Lisp / ASDF build outputs
*.fasl
*.ufasl
*.dfsl
*.lx32fsl
*.lx64fsl
*.wx32fsl
*.wx64fsl
*.abcl
*.fas
*.lib
*.x86f
*.sparcf
*.axpf
*.dxf
*.ppcf
*.sse2f

# Build/package scratch directories. The release payload under target/ is kept
# intentionally because the installers download versioned payloads from the
# same GitHub/Gitee tag.
build/
dist/
release/

# Keep raw executables local. Track the build scripts and program verification files.
target/*
!target/make-sha-asc.sh
!target/SHA256SUMS
!target/SHA256SUMS.asc
!target/TAFFISH-RELEASE-KEY.asc

# Publish complete platform archives, macOS transport parts and verification files in place.
!target/packages-[0-9]*/
target/packages-[0-9]*/*
!target/packages-[0-9]*/taffish-*-darwin-arm64.tar.xz
!target/packages-[0-9]*/taffish-*-darwin-arm64.tar.xz.parts
!target/packages-[0-9]*/taffish-*-darwin-arm64.tar.xz.part-[a-z][a-z]
!target/packages-[0-9]*/taffish-*-linux-amd64.tar.gz
!target/packages-[0-9]*/ARCHIVE-SHA256SUMS
!target/packages-[0-9]*/ARCHIVE-SHA256SUMS.asc
!target/packages-[0-9]*/TAFFISH-RELEASE-KEY.asc

# taf-app publish drafts should not be committed when this repository is used as
# a working TAFFISH project.
release.md

# Local AI/agent working notes. Keep agent instructions private for now.
AGENTS.md
AGENTS.local.md
docs-for-codex/
.codex-notes/
what-is-taffish.md
