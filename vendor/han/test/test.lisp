(in-package :han.test)

(deftest test-han-test-help-and-version ()
  (let ((help-string (han.test:help nil)))
    (check-true (stringp help-string))
    (check-true (search "han.test" help-string))
    (check-true (search "run-all-tests" help-string)))
  (check-equal "0.3.0" (han.test:version nil)))

(deftest test-check-error-requires-a-condition-from-the-body ()
  (check-true (handler-case (progn (check-error (error) (values)) nil)
                (simple-error () t)))
  (check-true (check-error (simple-error) (error "from the body"))))

(deftest test-runner-replacement-order-and-failure-counts ()
  (let ((*tests* nil)
        (*standard-output* (make-broadcast-stream))
        (calls '()))
    (deftest replaced () (push :old calls))
    (deftest first () (push :first calls))
    (deftest failing () (push :failing calls) (error "expected test failure"))
    (deftest replaced () (push :new calls) nil)
    (check-equal '(2 1) (multiple-value-list (run-all-tests)))
    (check-equal '(:first :failing :new) (reverse calls))))

(deftest test-reset-leaves-an-empty-registry ()
  (let ((*tests* nil)
        (*standard-output* (make-broadcast-stream)))
    (deftest local-test () t)
    (check-true (run-test 'local-test))
    (check-true (reset-tests))
    (check-equal '(0 0) (multiple-value-list (run-all-tests)))
    (check-error (simple-error) (run-test 'local-test))))

(deftest test-assertions-evaluate-operands-once ()
  (let ((calls '()))
    (flet ((observe (tag value) (push tag calls) value))
      (check-true (observe :truth 1))
      (check-false (observe :false nil))
      (check-equal (observe :expected "two") (observe :actual (copy-seq "two")))
      (check-error (simple-error) (check-true (observe :false-assertion nil)))
      (check-error (simple-error) (check-false (observe :true-assertion 1)))
      (check-error (simple-error) (check-equal 1 (observe :unequal 2)))
      (check-equal '(:truth :false :expected :actual :false-assertion
                     :true-assertion :unequal)
                   (reverse calls)))))

(deftest test-check-error-propagates-the-original-condition ()
  (let ((original (make-condition 'type-error :datum 7 :expected-type 'string)))
    (check-true (eq original
                    (handler-case (check-error (file-error) (error original))
                      (type-error (caught) caught))))))
